{
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "X-Frame-Options",
					"value": "SAMEORIGIN"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				}
			]
		},
		{
			"source": "/assets/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/(icons|badges|milestones)/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, stale-while-revalidate=86400"
				}
			]
		},
		{
			"source": "/(favicon.ico|favicon.svg|og-image.png|site.webmanifest)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=2592000, stale-while-revalidate=86400"
				}
			]
		},
		{
			"source": "/version.json",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, stale-while-revalidate=3600"
				}
			]
		},
		{
			"source": "/(.*).html",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=0, must-revalidate"
				}
			]
		}
	],
	"redirects": [
		{
			"source": "/download",
			"destination": "https://pub-threadfx.r2.dev/threadfx-latest.zip",
			"permanent": false
		}
	]
}
