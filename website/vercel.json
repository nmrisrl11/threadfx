{
	"headers": [
		{
			"source": "/assets/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/(icons|images)/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=2592000, stale-while-revalidate=86400"
				}
			]
		},
		{
			"source": "/(favicon.ico|favicon.svg|og-image.png|site.webmanifest)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=86400, stale-while-revalidate=86400"
				}
			]
		}
	],
	"redirects": [
		{
			"source": "/download",
			"destination": "https://pub-threadfx.r2.dev/threadfx-latest.zip",
			"permanent": false
		}
	]
}
